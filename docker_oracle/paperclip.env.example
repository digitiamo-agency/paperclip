# Runtime Paperclip per docker_oracle/docker-compose.yml
# Copia: cp docker_oracle/paperclip.env.example docker_oracle/paperclip.env
# Non committare paperclip.env (secret).

# Immagine (dopo publish su OCIR). Sovrascrivi tag/version se serve.
PAPERCLIP_IMAGE=lin.ocir.io/ax5avusujxyu/infinitearena/paperclip:latest

# Porta host → container 3100
PAPERCLIP_PORT=3100

# Volume dati (relativo a docker_oracle/ → root repo)
PAPERCLIP_DATA_DIR=../data/docker-paperclip-oracle

# Deployment
PAPERCLIP_DEPLOYMENT_MODE=authenticated
PAPERCLIP_DEPLOYMENT_EXPOSURE=private
PAPERCLIP_PUBLIC_URL=http://localhost:3100
# PAPERCLIP_ALLOWED_HOSTNAMES=paperclip.lan,100.x.x.x

# Secret obbligatori (genera: openssl rand -hex 32)
BETTER_AUTH_SECRET=
PAPERCLIP_TOOL_ACTION_SIGNING_SECRET=

# DB: lascia vuoto = Postgres embedded nel volume PAPERCLIP_HOME
# Con --profile db usa invece:
# DATABASE_URL=postgres://paperclip:paperclip@db:5432/paperclip
# POSTGRES_USER=paperclip
# POSTGRES_PASSWORD=paperclip
# POSTGRES_DB=paperclip
DATABASE_URL=

# Chiavi LLM (opzionali; almeno una per far lavorare gli agenti locali)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
