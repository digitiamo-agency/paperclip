# Variabili per docker_oracle/publish.sh (non committare docker_oracle/.env con secret)
# eu-frankfurt-1 → fra.ocir.io | eu-milan-1 → lin.ocir.io (vedi docker_oracle/lib/common.sh)
OCIR_REGION=eu-milan-1
# OCIR_HOST=lin.ocir.io   # opzionale: forza host se serve override
OCIR_NAMESPACE=your-tenancy-namespace
# Repository in OCIR (crealo prima in OCI → Developer Services → Container Registry)
OCIR_REPO=digitiamo/paperclip

# Target Dockerfile Paperclip: production (default) | cloud
DOCKER_TARGET=production

# Piattaforme buildx per publish (default: nativa host prima + cross → manifest list)
# Su Apple Silicon: linux/arm64,linux/amd64
# DOCKER_PLATFORMS=linux/arm64,linux/amd64
# Solo nativa (evita QEMU/OOM): DOCKER_PLATFORMS=linux/arm64
# Solo amd64: DOCKER_PLATFORMS=linux/amd64
# DOCKER_BUILDX_BUILDER=paperclip-multiarch

# Login automatico (opzionale; altrimenti docker login manuale prima del publish)
# Formato username: <OCIR_NAMESPACE>/<utente-oci>
#   IAM federato: <namespace>/oracleidentitycloudservice/<nome-utente>
#   utente locale: <namespace>/<nome-utente>
OCIR_USERNAME=your-tenancy-namespace/oracleidentitycloudservice/your.user
# Auth Token OCI (Profile → Auth Tokens). NON la password della console.
# Se il token contiene caratteri speciali, usa virgolette singole in .env:
# OCIR_PASSWORD='il-tuo-auth-token'
OCIR_PASSWORD=

# Tag aggiuntivi oltre a <semver>-<gitSha>
PUSH_SEMVER=true
PUSH_LATEST=true

# Sovrascrittura tag (opzionale; default = version da server/package.json + git sha)
# VERSION=0.3.1-custom
